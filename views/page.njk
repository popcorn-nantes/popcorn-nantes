{% extends "layout.njk" %}
{% import "macros.njk" as macros %}

{% set pageTitle = entity.title if entity.title else "Popcorn Nantes" %}

{% block head %}
  <title>{{ pageTitle }} | Popcorn Nantes</title>
  {% if entity.noindex %}<meta name="robots" content="noindex,follow">{% endif %}
  {{
    macros.socialMetas(
      title=pageTitle,
      description=entity.description if entity.description else pageTitle + " — Popcorn, l'annuaire des développeurs freelances à Nantes, sans intermédiaire ni commission.",
      url=entity.$url,
      image=SITE_BASE_URL + "/media/images/popcorn.jpg"
    )
  }}
{% endblock %}

{% block content %}
  {{ macros.breadcrumb([
    { "name": "Accueil", "url": "/" },
    { "name": pageTitle, "url": entity.$path }
  ]) }}

  <div class="container mx-auto mt-10 px-10">
    {% if entity.title and not entity.$hasH1 %}
      <h1 class="font-bold text-xl">{{ entity.title }}</h1>
    {% endif %}
    <div class="html-content mt-6">
      {{ entity.$html | safe }}
    </div>
  </div>
{% endblock %}
